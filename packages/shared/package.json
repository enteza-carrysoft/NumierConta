{
  "name": "@numierconta/shared",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./schemas/*": {
      "default": "./src/schemas/*.ts",
      "types": "./src/schemas/*.ts"
    },
    "./types/*": {
      "default": "./src/types/*.ts",
      "types": "./src/types/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0"
  }
}
